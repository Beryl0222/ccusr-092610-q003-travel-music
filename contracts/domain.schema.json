{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "山河漫游音乐素材谱系领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ASSET_REGISTERED",
        "RIGHTS_DECLARED",
        "REVISION_FROZEN",
        "RELEASE_POSTED",
        "TAKEDOWN_OPENED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "media_asset",
        "rights_grant",
        "edit_revision",
        "channel_release"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "ASSET_REGISTERED": [
      "content_hash",
      "source_kind"
    ],
    "RIGHTS_DECLARED": [
      "grantor_ref",
      "scope"
    ],
    "RELEASE_POSTED": [
      "channel",
      "revision_ref"
    ]
  },
  "additionalProperties": false
}
