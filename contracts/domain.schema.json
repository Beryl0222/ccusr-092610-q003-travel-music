{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "山河漫游音乐素材谱系领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ASSET_REGISTERED",
        "CONTRIBUTION_DECLARED",
        "RIGHTS_DECLARED",
        "RIGHTS_CONFIRMED",
        "REVISION_CREATED",
        "REVISION_SIGNED",
        "TRACK_LOCKED",
        "REVISION_FROZEN",
        "RELEASE_POSTED",
        "SOURCE_WITHDRAWN",
        "TAKEDOWN_OPENED",
        "TAKEDOWN_ENFORCED",
        "REPLACEMENT_TASK_OPENED",
        "CAMPAIGN_CLOSED",
        "CORRECTION_PROPAGATED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "media_asset",
        "contribution",
        "rights_grant",
        "edit_revision",
        "track_lock",
        "channel_release",
        "takedown_notice",
        "replacement_task",
        "campaign"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "ASSET_REGISTERED": [
      "content_hash",
      "source_kind"
    ],
    "CONTRIBUTION_DECLARED": [
      "creator_id",
      "role",
      "asset_ref"
    ],
    "RIGHTS_DECLARED": [
      "grantor_ref",
      "scope"
    ],
    "RIGHTS_CONFIRMED": [
      "grant_ref",
      "confirmed_by"
    ],
    "REVISION_CREATED": [
      "items"
    ],
    "REVISION_SIGNED": [
      "sign_kind",
      "signer"
    ],
    "TRACK_LOCKED": [
      "revision_ref",
      "track_ref"
    ],
    "REVISION_FROZEN": [
      "frozen_items",
      "channel"
    ],
    "RELEASE_POSTED": [
      "channel",
      "revision_ref"
    ],
    "SOURCE_WITHDRAWN": [
      "reason"
    ],
    "TAKEDOWN_OPENED": [
      "asset_ref",
      "reason",
      "deadline_at"
    ],
    "TAKEDOWN_ENFORCED": [
      "takedown_ref"
    ],
    "REPLACEMENT_TASK_OPENED": [
      "release_ref",
      "asset_ref",
      "scope"
    ],
    "CAMPAIGN_CLOSED": [
      "evidence_ref"
    ],
    "CORRECTION_PROPAGATED": [
      "release_ref",
      "notice"
    ]
  },
  "additionalProperties": false
}
